# Copy to .env.local. NEVER commit .env.local.

# Public site URL (used for sitemap / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Enquiry form delivery (Resend, https://resend.com) ---
# Without these the form shows an honest "not configured" error. It never fakes success.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=

# --- Spam protection: Cloudflare Turnstile (optional but recommended) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- AI Studio provider: none | replicate ---
# "none" = clearly labelled demo mode (no videos are generated).
AI_PROVIDER=none
REPLICATE_API_TOKEN=
# Replicate model "owner/name" that accepts a text prompt (and optionally image). Check its input schema.
REPLICATE_VIDEO_MODEL=
# Optional: set to "true" if the model accepts an `image` input
REPLICATE_SUPPORTS_IMAGE=false

# --- Admin / accounts (not active until you wire a database; see README) ---
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
